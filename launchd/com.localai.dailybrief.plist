<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.localai.dailybrief</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/munbyeongcheon/IdeaProjects/LocalAI/.venv/bin/python</string>
        <string>/Users/munbyeongcheon/IdeaProjects/LocalAI/scripts/daily_brief.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/munbyeongcheon/IdeaProjects/LocalAI</string>

    <!-- 매일 오전 08:45 실행 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/localai.dailybrief.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/localai.dailybrief.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/munbyeongcheon</string>
    </dict>
</dict>
</plist>
